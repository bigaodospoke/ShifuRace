{
  "schemaVersion": 1,
  "id": "shifurace",
  "version": "${version}",
  "name": "ShifuRace",
  "description": "Corridas de Pokémon estilo F1 para o Eclipse Cobblemon: pistas com checkpoints montadas no jogo, Porytronz emprestado igual para todos, cronômetro por volta, troféu do vencedor e placar com os melhores tempos.",
  "authors": ["bigaodospoke"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/shifurace/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{ "adapter": "kotlin", "value": "com.shifurace.ShifuRace" }],
    "client": [{ "adapter": "kotlin", "value": "com.shifurace.client.ShifuRaceClient" }]
  },
  "mixins": [
    "shifurace.mixins.json",
    { "config": "shifurace.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": ">=0.116.0",
    "fabric-language-kotlin": ">=1.13.6+kotlin.2.2.20",
    "cobblemon": ">=1.7.3"
  }
}
